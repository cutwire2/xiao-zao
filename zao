local function createLineArrowDecoration(parent, side)
	local lineThickness = 1
	local arrowColor = Color3.fromRGB(80, 68, 50)
	local lineColor = Color3.fromRGB(100, 84, 60)
	local arrowWidth = 7
	local arrowHeight = 6
	local hPad = 1
	local isLeft = side == "Left"
	local containerW = arrowWidth + hPad * 2

	local ArrowContainer = Instance.new("Frame")
	ArrowContainer.Name = side .. "ArrowDecoration"
	ArrowContainer.Size = UDim2.new(0, containerW, 1, -52)
	if isLeft then
		ArrowContainer.Position = UDim2.new(0, 132, 0, 40)
	else
		ArrowContainer.Position = UDim2.new(1, -(containerW + 5), 0, 40)
	end
	ArrowContainer.BackgroundTransparency = 1
	ArrowContainer.ZIndex = 1
	ArrowContainer.ClipsDescendants = false
	ArrowContainer.Active = false
	ArrowContainer.Selectable = false
	ArrowContainer.Parent = parent

	local centerX = hPad + arrowWidth / 2

	local function makeFrame(name, x, y, w, h, color)
		local f = Instance.new("Frame")
		f.Name = name
		f.Size = UDim2.new(0, w, 0, h)
		f.Position = UDim2.new(0, x, 0, y)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.ZIndex = 1
		f.Active = false
		f.Selectable = false
		f.Parent = ArrowContainer
		return f
	end

	local function createLine(x, y, w, h, name)
		return makeFrame(name, x, y, w, h, lineColor)
	end

	local function createArrowTriangle(centerXPos, yPos, isPointingUp)
		local halfWidth = arrowWidth / 2
		local prefix = isPointingUp and "UpArrow" or "DownArrow"
		local maxH = math.max(arrowHeight - 1, 1)

		for i = 0, arrowHeight - 1 do
			local progress = i / maxH
			local t = isPointingUp and (1 - progress) or progress
			local rowWidth = math.max(math.floor(halfWidth * t * 2 + 0.5), lineThickness)
			local rowY = isPointingUp and (yPos + i) or (yPos + arrowHeight - 1 - i)
			makeFrame(prefix .. "_Row_" .. i, centerXPos - rowWidth / 2, rowY, rowWidth, lineThickness, arrowColor)
		end

		local edgeTotal = math.ceil(math.sqrt(halfWidth * halfWidth + arrowHeight * arrowHeight)) + 2
		for s = 0, edgeTotal do
			local t = math.clamp(s / edgeTotal, 0, 1)
			local widthT = isPointingUp and (1 - t) or t
			local heightT = isPointingUp and t or (1 - t)
			local ey = yPos + (arrowHeight - 1) * heightT
			local lx = centerXPos - halfWidth * widthT
			local rx = centerXPos + halfWidth * widthT
			makeFrame(prefix .. "_LEdge_" .. s, math.floor(lx + 0.5), math.floor(ey + 0.5), lineThickness, lineThickness, arrowColor)
			makeFrame(prefix .. "_REdge_" .. s, math.floor(rx + 0.5), math.floor(ey + 0.5), lineThickness, lineThickness, arrowColor)
		end
	end

	local topExtendLine = createLine(centerX - 0.5, 0, lineThickness, 0, "TopExtend")
	local middleConnector = createLine(centerX - 0.5, 0, lineThickness, 0, "MidConnect")
	local bottomExtendLine = createLine(centerX - 0.5, 0, lineThickness, 0, "BottomExtend")

	local topArrowY = 4
	local bottomArrowY = nil
	local upArrowBaseY = topArrowY + arrowHeight

	local function clearPattern(pat)
		for _, ch in ipairs(ArrowContainer:GetChildren()) do
			if ch:IsA("Frame") and ch.Name:match(pat) then
				ch:Destroy()
			end
		end
	end

	local function updateLayout()
		local absY = ArrowContainer.AbsoluteSize.Y
		if absY <= 0 then
			ArrowContainer.Visible = false
			return
		end
		ArrowContainer.Visible = true

		local minNeed = arrowHeight * 2 + 16
		if absY < minNeed then
			topExtendLine.Size = UDim2.new(0, 0, 0, 0)
			middleConnector.Size = UDim2.new(0, 0, 0, 0)
			bottomExtendLine.Size = UDim2.new(0, 0, 0, 0)
			clearPattern("^UpArrow")
			clearPattern("^DownArrow")
			bottomArrowY = nil
			return
		end

		bottomArrowY = absY - arrowHeight - 4
		local downTipY = bottomArrowY + arrowHeight

		topExtendLine.Size = UDim2.new(0, lineThickness, 0, topArrowY)
		topExtendLine.Position = UDim2.new(0, centerX - 0.5, 0, 0)

		local mStart = upArrowBaseY
		local mEnd = bottomArrowY
		if mEnd > mStart then
			middleConnector.Size = UDim2.new(0, lineThickness, 0, mEnd - mStart)
			middleConnector.Position = UDim2.new(0, centerX - 0.5, 0, mStart)
		else
			middleConnector.Size = UDim2.new(0, 0, 0, 0)
		end

		if absY > downTipY then
			bottomExtendLine.Size = UDim2.new(0, lineThickness, 0, absY - downTipY)
			bottomExtendLine.Position = UDim2.new(0, centerX - 0.5, 0, downTipY)
		else
			bottomExtendLine.Size = UDim2.new(0, 0, 0, 0)
		end
	end

	local function rebuildArrows()
		clearPattern("^UpArrow")
		clearPattern("^DownArrow")
		local absY = ArrowContainer.AbsoluteSize.Y
		if absY <= 0 or absY < (arrowHeight * 2 + 16) then return end
		createArrowTriangle(centerX, topArrowY, true)
		if bottomArrowY then
			createArrowTriangle(centerX, bottomArrowY, false)
		end
	end

	local function fullRefresh()
		if not ArrowContainer:IsDescendantOf(game) then return end
		updateLayout()
		rebuildArrows()
	end

	fullRefresh()

	ArrowContainer.Changed:Connect(function(p)
		if p == "AbsoluteSize" or p == "Size" then fullRefresh() end
	end)
	ArrowContainer.AncestryChanged:Connect(function()
		if ArrowContainer:IsDescendantOf(game) then task.defer(fullRefresh) end
	end)
	task.defer(fullRefresh)
	task.delay(0.3, fullRefresh)
end

