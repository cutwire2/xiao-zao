	StripeOverlay.ClipsDescendants = true
	StripeOverlay.ZIndex = 100
	StripeOverlay.Active = true
	StripeOverlay.Selectable = false
	StripeOverlay.Parent = MainFrame

	local InputBlocker = Instance.new("TextButton")
	InputBlocker.Name = "InputBlocker"
	InputBlocker.Size = UDim2.new(1, 0, 1, 0)
	InputBlocker.Position = UDim2.new(0, 0, 0, 0)
	InputBlocker.BackgroundTransparency = 1
	InputBlocker.Text = ""
	InputBlocker.AutoButtonColor = false
	InputBlocker.ZIndex = 101
	InputBlocker.Active = true
	InputBlocker.Selectable = false
	InputBlocker.Parent = StripeOverlay

	local RetroTint = Instance.new("Frame")
	RetroTint.Name = "RetroTint"
	RetroTint.Size = UDim2.new(1, 0, 1, 0)
	RetroTint.Position = UDim2.new(0, 0, 0, 0)
	RetroTint.BackgroundColor3 = Color3.fromRGB(170, 130, 85)
	RetroTint.BackgroundTransparency = 0.82
	RetroTint.BorderSizePixel = 0
	RetroTint.ZIndex = 102
	RetroTint.Active = false
	RetroTint.Selectable = false
	RetroTint.Parent = StripeOverlay

	local revealStripes = {}
	local revealStripeCount = 32
	local revealColorA = Color3.fromRGB(245, 238, 220)
	local revealColorB = Color3.fromRGB(15, 15, 15)

	for i = 1, revealStripeCount do
		local s = Instance.new("Frame")
		s.Name = "RevealStripe_" .. i
		s.Size = UDim2.new(1, 0, 1 / revealStripeCount, 0)
		s.Position = UDim2.new(0, 0, (i - 1) / revealStripeCount, 0)
		s.BackgroundColor3 = (i % 2 == 0) and revealColorA or revealColorB
		s.BackgroundTransparency = 0
		s.BorderSizePixel = 0
		s.ZIndex = 100
		s.Active = false
		s.Selectable = false
		s.Parent = StripeOverlay
		revealStripes[i] = s
	end

	local function finishReveal()
		revealRunning = false
		if StripeOverlay then StripeOverlay:Destroy() end
		mainUIReady = true
		pcall(function()
			if bgmPlaying and bgmSound and not bgmSound.IsPlaying then bgmSound:Play() end
			if loadSfx2 and loadSfx2.Parent then
				loadSfx2:Stop()
				loadSfx2.TimePosition = 0
				loadSfx2:Play()
			end
		end)
	end

	local function playReveal()
		task.wait(0.15)
		if not StripeOverlay or not StripeOverlay.Parent then
			revealRunning = false
			return
		end

		local width = MainFrame.AbsoluteSize.X
		local totalBars = #revealStripes
		local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local stepDelay = 0.035

		if RetroTint then
			TweenService:Create(RetroTint, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1
			}):Play()
		end

		for i = 1, totalBars do
			local bar = revealStripes[i]
			if not bar then continue end
			local dir = (i % 2 == 0) and 1 or -1
			local targetPos = UDim2.new(0, dir * (width + 200), bar.Position.Y.Scale, 0)

			task.delay((i - 1) * stepDelay, function()
				if not bar or not bar.Parent then return end
				local t = TweenService:Create(bar, tweenInfo, {
					Position = targetPos,
					BackgroundTransparency = 1
				})
				t.Completed:Connect(function()
					if bar then bar:Destroy() end
				end)
				t:Play()
			end)
		end

		local totalTime = (totalBars - 1) * stepDelay + 0.65
		task.delay(totalTime, finishReveal)
	end

	coroutine.wrap(playReveal)()
end

