local volumeDragging = false

local function updateVolume(inputX)
	local trackPos = volumeTrack.AbsolutePosition
	local trackSize = volumeTrack.AbsoluteSize
	
	local relativeX = inputX - trackPos.X
	relativeX = math.clamp(relativeX, 0, trackSize.X)
	
	local ratio = relativeX / trackSize.X
	local volume = math.clamp(ratio, 0, 1)
	
	pcall(function()
		bgmSound.Volume = volume
		if loadSfx1 then loadSfx1.Volume = volume * 10 end
		if loadSfx2 then loadSfx2.Volume = volume * 10 end
	end)

	volumeFill.Size = UDim2.new(ratio, 0, 1, 0)
	volumeButton.Position = UDim2.new(ratio, -6, 0.5, -6)
	volumeLabel.Text = "音量: " .. math.floor(ratio * 100) .. "%"
end

