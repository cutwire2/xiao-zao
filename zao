local function fadeOutLoadingScreen()
	local tweenInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	for _, element in ipairs({LoadingBackground, CornerFrame, CornerAccent, Logo, SubText, LoadingText, ProgressBarBg, ProgressBarFill, ProgressCaption, ScanlineContainer}) do
		if element:IsA("TextLabel") then
			TweenService:Create(element, tweenInfo, {TextTransparency = 1}):Play()
		elseif element == ProgressBarFill then
			TweenService:Create(element, tweenInfo, {BackgroundTransparency = 1}):Play()
		else
			TweenService:Create(element, tweenInfo, {BackgroundTransparency = 1}):Play()
		end
	end
	for _, dot in ipairs(NoiseDots) do
		TweenService:Create(dot, tweenInfo, {BackgroundTransparency = 1}):Play()
	end
	task.wait(0.75)
	LoadingScreen:Destroy()
end

local function fadeInElement(element, delayTime, originalTransparency)
	task.wait(delayTime)
	local targetProps = {}
	if element:IsA("ImageLabel") then
		element.ImageTransparency = 1
		targetProps.ImageTransparency = originalTransparency or 0
	else
		element.BackgroundTransparency = 1
		targetProps.BackgroundTransparency = originalTransparency or 0
	end
	if element:IsA("TextLabel") then
		element.TextTransparency = 1
		targetProps.TextTransparency = 0
	end
	TweenService:Create(element, TweenInfo.new(0.65, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), targetProps):Play()
end

