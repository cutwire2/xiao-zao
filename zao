local function startMainUIReveal()
	if revealRunning then return end
	if not MainFrame or not MainFrame.Parent then return end

	revealRunning = true
	mainUIReady = false

	local old = MainFrame:FindFirstChild("StripeRevealOverlay")
	if old then old:Destroy() end

	local StripeOverlay = Instance.new("Frame")
	StripeOverlay.Name = "StripeRevealOverlay"
