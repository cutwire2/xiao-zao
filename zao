	local currentPickThread = nil

	local function getItemContainer()
		local gameFolder = workspace:FindFirstChild("Game")
		if not gameFolder then return nil end
		local entities = gameFolder:FindFirstChild("Entities")
		if not entities then return nil end
		return entities:FindFirstChild("ItemPickup")
	end

	local function fireProximityPrompt(prompt)
		if not prompt then return end
		pcall(function()
			if fireproximityprompt then
				fireproximityprompt(prompt)
			elseif prompt:FindFirstChild("Triggered") then
				firesignal(prompt.Triggered)
			else
				prompt:InputHoldBegin()
				task.wait(0.05)
				prompt:InputHoldEnd()
			end
		end)
	end

	local function pickUpItems()
		if not config.autoPickEnabled then return end

		local character = LocalPlayer.Character
		if not character then return end
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end

		local itemContainer = getItemContainer()
		if not itemContainer then
			statusLabel.Text = "⚠️ 未找到物品文件夹"
			return
		end

		local pickedCount = 0

		for _, itemFolder in ipairs(itemContainer:GetChildren()) do
			if not config.autoPickEnabled then break end
			for _, itemPart in ipairs(itemFolder:GetChildren()) do
				if not config.autoPickEnabled then break end
				if itemPart:IsA("MeshPart") or itemPart:IsA("Part") then
					local prompt = itemPart:FindFirstChildOfClass("ProximityPrompt")
					if prompt then
						local itemName = prompt.ObjectText or itemFolder.Name
						local isTarget = false
						for _, target in ipairs(config.targetItems) do
							if itemName == target then
								isTarget = true
								break
							end
						end

						if isTarget then
							rootPart.CFrame = itemPart.CFrame + Vector3.new(0, 2, 0)
							task.wait(0.05)
							prompt.RequiresLineOfSight = false
							prompt.HoldDuration = 0
							fireProximityPrompt(prompt)
							pickedCount += 1
							statusLabel.Text = "✅ 捡到: " .. itemName
							task.wait(0.03)
						end
					end
				end
			end
		end

		if pickedCount == 0 then
			statusLabel.Text = "🔍 扫描中... 未发现目标物品"
		end
	end

	local function startAutoPick()
		if currentPickThread then
			task.cancel(currentPickThread)
			currentPickThread = nil
		end

		currentPickThread = task.spawn(function()
			while config.autoPickEnabled do
				pcall(pickUpItems)
				task.wait(0.15)
			end
			currentPickThread = nil
		end)
	end

	local function stopAutoPick()
		if currentPickThread then
			task.cancel(currentPickThread)
			currentPickThread = nil
		end
	end

