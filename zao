	local pos = UserInputService:GetMouseLocation()
	RetroCursor.Position = UDim2.fromOffset(pos.X, pos.Y)

	frameCounter = frameCounter + 1
	local moved = not lastTrailPosition or (pos - lastTrailPosition).Magnitude >= 4
	if moved and frameCounter % SPAWN_INTERVAL_FRAMES == 0 then
		spawnTrailParticle(pos.X + 4, pos.Y + 6)
		lastTrailPosition = pos
	end
end)

local function clearTrailParticles()
	lastTrailPosition = nil
	for i = #activeTrails, 1, -1 do
		local t = activeTrails[i]
		pcall(function()
			if t and t.Parent then t:Destroy() end
		end)
		table.remove(activeTrails, i)
	end
	pcall(function()
		if TrailContainer then
			for _, child in ipairs(TrailContainer:GetChildren()) do
				child:Destroy()
			end
		end
	end)
end

