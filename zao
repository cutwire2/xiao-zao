local TrailContainer = Instance.new("Folder")
TrailContainer.Name = "TrailContainer"
TrailContainer.Parent = RetroCursorGui

local MAX_TRAIL_PARTICLES = 6
local SPAWN_INTERVAL_FRAMES = 3
local TRAIL_LIFETIME = 0.3
local PARTICLE_SIZE = 4
local TRAIL_FILL = Color3.fromRGB(245, 238, 220)
local TRAIL_OUTLINE = Color3.fromRGB(15, 15, 15)
local TRAIL_BG_Z = 9998
local TRAIL_FG_Z = 9999

local activeTrails = {}
local frameCounter = 0
local lastTrailPosition = nil
local trailTweenInfo = TweenInfo.new(TRAIL_LIFETIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function spawnTrailParticle(x, y)
	local base = Instance.new("Frame")
	base.Name = "trail"
	base.Size = UDim2.fromOffset(PARTICLE_SIZE, PARTICLE_SIZE)
	base.Position = UDim2.fromOffset(x, y)
	base.BackgroundColor3 = TRAIL_OUTLINE
	base.BorderSizePixel = 0
	base.ZIndex = TRAIL_BG_Z
	base.BackgroundTransparency = 0
	base.Parent = TrailContainer

	local inner = Instance.new("Frame")
	inner.Name = "fill"
	inner.Size = UDim2.fromOffset(PARTICLE_SIZE - 2, PARTICLE_SIZE - 2)
	inner.Position = UDim2.fromOffset(1, 1)
	inner.BackgroundColor3 = TRAIL_FILL
	inner.BorderSizePixel = 0
	inner.ZIndex = TRAIL_FG_Z
	inner.BackgroundTransparency = 0
	inner.Parent = base

	local target = UDim2.fromOffset(x + 1, y + 1)
	local shrinkTween = TweenService:Create(base, trailTweenInfo, {
		Size = UDim2.fromOffset(1, 1),
		Position = target,
		BackgroundTransparency = 1,
	})
	local innerTween = TweenService:Create(inner, trailTweenInfo, {
		BackgroundTransparency = 1,
	})

	shrinkTween.Completed:Connect(function()
		innerTween:Cancel()
		if base and base.Parent then base:Destroy() end
		for i, t in ipairs(activeTrails) do
			if t == base then
				table.remove(activeTrails, i)
				break
			end
		end
	end)

	shrinkTween:Play()
	innerTween:Play()

	table.insert(activeTrails, base)
	while #activeTrails > MAX_TRAIL_PARTICLES do
		local oldest = table.remove(activeTrails, 1)
		if oldest and oldest.Parent then
			pcall(function() oldest:Destroy() end)
		end
	end
end

local retroCursorConn
