local totalHeight = 26 * 28
local function startStripeAnimation()
	local t = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if not LoadingScreen or not LoadingScreen:IsDescendantOf(game) then
			if connection then connection:Disconnect() end
			return
		end
		t += dt
		for i, line in ipairs(Scanlines) do
			local baseY = ((i - 1) * 28 + (t * 18)) % totalHeight
			line.Position = UDim2.new(0, 0, 0, baseY)
		end
		for i, dot in ipairs(NoiseDots) do
			if (i + math.floor(t * 12)) % 5 == 0 then
				dot.BackgroundTransparency = 0.45 + ((i % 3) * 0.12)
			else
				dot.BackgroundTransparency = 0.82
			end
		end
		Logo.TextTransparency = 0.03 + math.sin(t * 2) * 0.03
		LoadingText.Text = ({"BOOTING MODULES", "CALIBRATING UI", "LOADING RETRO ASSETS", "PREPARING INTERFACE"})[(math.floor(t * 2) % 4) + 1]
	end)
end

