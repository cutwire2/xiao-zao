	local function isPlayerInRange(p, range)
		local rootPart = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
		local targetCharacter = p.Character
		if targetCharacter then
			local targetRootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
			if targetRootPart then
				local distance = (rootPart.Position - targetRootPart.Position).Magnitude
				return distance <= range
			end
		end
