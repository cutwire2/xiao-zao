	if not realDragging then return end
	local delta = input.Position - dragStart
	MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

local function beginDragCapture(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	dragging = true
	realDragging = false
	dragStart = input.Position
	startPos = MainFrame.Position
	startPixel = Vector2.new(input.Position.X, input.Position.Y)

	if dragEndConn then dragEndConn:Disconnect() end
	dragEndConn = input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
			realDragging = false
			if dragEndConn then
				dragEndConn:Disconnect()
				dragEndConn = nil
			end
		end
	end)
end

TitleBar.InputBegan:Connect(function(input, gameProcessed)
	beginDragCapture(input)
end)

TabContainer.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Touch then
		beginDragCapture(input)
	end
end)


UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if everythingDestroyed then return end
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local curPixel = Vector2.new(input.Position.X, input.Position.Y)
		local dx = curPixel.X - startPixel.X
		local dy = curPixel.Y - startPixel.Y
		if (dx * dx + dy * dy) >= DRAG_THRESHOLD_PX * DRAG_THRESHOLD_PX then
			realDragging = true
		end
		updateDrag(input)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		local curPixel = Vector2.new(input.Position.X, input.Position.Y)
		local dx = curPixel.X - startPixel.X
		local dy = curPixel.Y - startPixel.Y
		if (dx * dx + dy * dy) >= DRAG_THRESHOLD_PX * DRAG_THRESHOLD_PX then
			realDragging = true
		end
		updateDrag(input)
	end
end)

