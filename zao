		{1, 6}, {2, 6}, {3, 6},
		{1, 7}, {2, 7},
		{1, 8},
	}

	local outline = {}
	for _, p in ipairs(fill) do
		local fx, fy = p[1], p[2]
		for dx = -1, 1 do
			for dy = -1, 1 do
				local x, y = fx + dx, fy + dy
				if x >= 1 and y >= 1 and x <= grid and y <= grid then
					outline[x .. "_" .. y] = {x, y}
				end
			end
		end
	end
	for _, p in ipairs(fill) do
		outline[p[1] .. "_" .. p[2]] = nil
	end

	for _, p in pairs(outline) do
		createPixel(p[1], p[2], Color3.fromRGB(15, 15, 15), 10000)
	end
