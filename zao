	local function detectAnimations()
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local inRange = false
				if detectionMode == "360" then
					inRange = isPlayerInRange(p, 50)
				end
				if inRange then
					local c = p.Character
					if c and c:FindFirstChildOfClass("Humanoid") then
						for _, animTrack in pairs(c.Humanoid:GetPlayingAnimationTracks()) do
							local animId = animTrack.Animation.AnimationId:match("%d+$")
							if not isLocalPlayerPlayingAnimation() then
								if punchAnimations[animId] or dashAnimations[animId] or skillAnimations[animId] then
									local argsPress = {
										[1] = {
											["Goal"] = "KeyPress",
											["Key"] = Enum.KeyCode.F
										}
									}
									pcall(function()
										LocalPlayer.Character.Communicate:FireServer(unpack(argsPress))
									end)
									local delayTime = 0.45
									if dashAnimations[animId] then
										delayTime = 0.90
									elseif skillAnimations[animId] then
										delayTime = skillAnimations[animId]
									end
									task.wait(delayTime)
									local argsRelease = {
										[1] = {
											["Goal"] = "KeyRelease",
											["Key"] = Enum.KeyCode.F
										}
									}
