	local function getServerRegion(serverId)
		local idLower = string.lower(serverId)
		for _, region in ipairs(priorityRegions) do
			if string.find(idLower, string.lower(region)) then
				return region
			end
		end
		if string.sub(idLower, 1, 3) == "jp_" or string.sub(idLower, 1, 3) == "jpn" then
			return "Japan"
		end
		if string.find(idLower, "sg_") or string.find(idLower, "sea") then
			return "SoutheastAsia"
		end
		return nil
	end

	local function getServersWithPriority()
		local priorityServers = {}
		local otherServers = {}
		local cursor = ""

		hopStatus.Text = "🔄 正在获取服务器列表..."
		hopStatus.TextColor3 = Color3.fromRGB(150, 130, 100)

		for _ = 1, 3 do
			local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100&sortOrder=Desc"
			if cursor ~= "" then
				url = url .. "&cursor=" .. cursor
			end

			local ok, response = pcall(function()
				return game:HttpGet(url)
			end)

			if not ok then break end

			local data = HttpService:JSONDecode(response)
			if data and data.data then
				for _, server in ipairs(data.data) do
					if server.id ~= currentJobId and server.playing < server.maxPlayers and server.playing > 0 then
						local region = getServerRegion(server.id)
						if region then
							table.insert(priorityServers, {id = server.id, region = region})
						else
							table.insert(otherServers, server.id)
						end
					end
				end
			end

			if data and data.nextPageCursor then
				cursor = data.nextPageCursor
			else
				break
			end
		end

		return priorityServers, otherServers
	end

	local function hopServer()
