-- 按钮制作函数
local function makeBtn(label, xOff, bgColor, textColor)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 26, 0, 24)
	b.Position = UDim2.new(1, xOff, 0.5, -12)
	b.BackgroundColor3 = bgColor
	b.Text = label
	b.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
	b.TextSize = 14
	b.Font = Enum.Font.GothamBold
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.ZIndex = 4
	b.Parent = titleBar
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.1), {BackgroundTransparency = 0.2}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.1), {BackgroundTransparency = 0}):Play()
	end)
	return b
end

