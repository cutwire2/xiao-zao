-- 最小化逻辑
local minimized = false
local tweening = false

local function setMinimized(val)
	if tweening then return end
	tweening = true
	minimized = val
	if not val then body.Visible = true end
	local tween = TweenService:Create(win, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, WIN_W, 0, val and WIN_H_MIN or WIN_H_FULL)
	})
	tween:Play()
	tween.Completed:Connect(function()
		if val then body.Visible = false end
		tweening = false
	end)
end

minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)
minBtn.TouchTap:Connect(function() setMinimized(not minimized) end)

